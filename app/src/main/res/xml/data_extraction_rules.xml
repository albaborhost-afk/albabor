<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup policy.
  Exclude the DataStore containing the auth token to avoid leaking session
  credentials to Google Cloud / device-to-device transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/albabor_prefs.preferences_pb" />
        <exclude domain="sharedpref" path="albabor_prefs" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/albabor_prefs.preferences_pb" />
        <exclude domain="sharedpref" path="albabor_prefs" />
    </device-transfer>
</data-extraction-rules>
